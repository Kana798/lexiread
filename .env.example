# DEEPSEEK_API_KEY: Enables the built-in AI engine (rewrite, tutor, grammar,
# quiz, bilingual align...). Get one at https://platform.deepseek.com —
# or paste it directly in the app's first-run guide, which writes it to
# %APPDATA%/LexiRead/.env for you.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# Youdao Zhiyun V3 Translation. Keep both values private in your local .env.
YOUDAO_APP_KEY="YOUR_YOUDAO_APP_KEY"
YOUDAO_APP_SECRET="YOUR_YOUDAO_APP_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
