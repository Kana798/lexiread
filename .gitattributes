# 统一换行符，避免 Windows / macOS / Linux 之间的行尾抖动
* text=auto

# Windows 批处理必须是 CRLF，否则部分命令会解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 脚本与配置统一 LF
*.sh   text eol=lf
*.ts   text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.mp3  binary
*.woff binary
*.woff2 binary
