# 依赖与构建产物
node_modules/
# build/ 是 electron-builder 的资源目录（build/icon.png 是应用图标，需入库），
# 因此只忽略目录内容、保留例外文件
build/*
!build/icon.png
dist/
release/
release-fixed/
win-unpacked/
coverage/
.vite/
*.tsbuildinfo

# 本地环境与密钥（绝不入库）
.env*
!.env.example
config/defaults.env
!config/defaults.env.example

# 智能体 / 编辑器会话数据
.superpowers/
.idea/
.vs/
.vscode/

# 系统与日志
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
